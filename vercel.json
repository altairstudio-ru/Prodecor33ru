{
  "buildCommand": "astro build && mkdir -p .vercel/output/static/seo-reports && cp -r seo-reports/reports/* .vercel/output/static/seo-reports/",
  "outputDirectory": "dist",
  "framework": "astro",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "prodecor33ru.vercel.app" }],
      "destination": "https://prodecor33.ru/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "prodecor33ru.vercel.app" }],
      "destination": "https://prodecor33.ru/:path*",
      "permanent": true
    }
  ]
}