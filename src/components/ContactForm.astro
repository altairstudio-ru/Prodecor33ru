---
import Icon from './Icon.astro';

const PROJECT_TYPES = [
  { value: 'design', label: 'Дизайн' },
  { value: 'renovation', label: 'Ремонт' },
  { value: 'full', label: 'Под ключ' },
  { value: 'supervision', label: 'Надзор' },
];
---
<section id="contact" class="py-20 px-6 bg-white">
  <div class="max-w-4xl mx-auto">
    <div class="bg-[#F5F3EF] rounded-2xl p-12">
      <div class="text-center mb-12">
        <h2 class="text-4xl lg:text-5xl text-[#1F1F1F] mb-4">
          Получите бесплатную консультацию
        </h2>
        <p class="text-lg text-[#8A8A8A]">
          Обсудим ваш проект, расскажем о процессе работы и предоставим предварительную смету
        </p>
      </div>
      <form data-lead-form data-source="Форма на странице" novalidate class="space-y-8">
        <input type="hidden" name="projectType" value="design" />
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <label for="contact-name" class="block text-sm font-medium text-[#1F1F1F] mb-2">
              Ваше имя
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              class="w-full px-4 py-3 bg-white border border-[#D1D1D1] rounded-lg focus:outline-none focus:border-[#C6A96B] transition-colors text-[#1F1F1F]"
              placeholder="Иван Петров"
              autocomplete="name"
            />
          </div>
          <div>
            <label for="contact-phone" class="block text-sm font-medium text-[#1F1F1F] mb-2">
              Телефон
            </label>
            <input
              type="tel"
              id="contact-phone"
              name="phone"
              data-phone-mask
              class="w-full px-4 py-3 bg-white border border-[#D1D1D1] rounded-lg focus:outline-none focus:border-[#C6A96B] transition-colors text-[#1F1F1F]"
              placeholder="+7 (___) ___-__-__"
              autocomplete="tel"
            />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-[#1F1F1F] mb-4">Тип проекта</label>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {
              PROJECT_TYPES.map((option) => (
                <button
                  type="button"
                  data-project-type={option.value}
                  class="px-5 py-3.5 rounded-lg transition-all bg-transparent border border-[#D1D1D1] text-[#1F1F1F] hover:border-[#C6A96B] hover:bg-white/50"
                >
                  {option.label}
                </button>
              ))
            }
          </div>
        </div>
        <div class="pt-2">
          <button
            type="submit"
            data-lead-submit
            class="w-full md:w-auto px-10 py-4 bg-[#C6A96B] text-white rounded-lg hover:bg-[#B39960] transition-colors font-medium inline-flex items-center justify-center gap-2 shadow-sm disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <span data-submit-label class="inline-flex items-center gap-2">
              Получить консультацию
              <Icon name="arrow-right" class="w-5 h-5" />
            </span>
            <span data-submit-loading class="hidden items-center gap-3">
              <span class="w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin" />
              Отправка...
            </span>
          </button>
        </div>
        <p class="text-xs text-[#8A8A8A] text-center pt-2">
          Нажимая кнопку, вы соглашаетесь с политикой конфиденциальности
        </p>
      </form>
    </div>
  </div>
</section>